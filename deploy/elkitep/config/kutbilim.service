[Unit]
Description=Kut Bilim backend (Django + Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/kutbilim/backend
EnvironmentFile=/etc/kutbilim/kutbilim.env
ExecStart=/srv/kutbilim/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
